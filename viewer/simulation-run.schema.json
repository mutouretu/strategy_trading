{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation-run.schema.json",
  "title": "SimulationRun",
  "type": "object",
  "required": ["schema_version", "manifest", "market", "orders", "fills"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "manifest": {
      "type": "object",
      "required": ["run_id", "instrument", "interval"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "instrument": {"type": "string", "minLength": 1},
        "interval": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "seed": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "market": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "timestamp",
          "instrument",
          "open",
          "high",
          "low",
          "close"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "timestamp": {"type": "integer"},
          "date": {"type": "string", "format": "date"},
          "instrument": {"type": "string", "minLength": 1},
          "open": {"$ref": "#/$defs/price"},
          "high": {"$ref": "#/$defs/price"},
          "low": {"$ref": "#/$defs/price"},
          "close": {"$ref": "#/$defs/price"}
        },
        "additionalProperties": true
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order_key",
          "instrument",
          "side",
          "order_type",
          "quantity",
          "active_from_sequence",
          "active_to_sequence",
          "status"
        ],
        "properties": {
          "order_key": {"type": "string", "minLength": 1},
          "instrument": {"type": "string", "minLength": 1},
          "side": {"enum": ["BUY", "SELL"]},
          "order_type": {"enum": ["LIMIT", "MARKET"]},
          "quantity": {"$ref": "#/$defs/price"},
          "price": {
            "oneOf": [
              {"$ref": "#/$defs/price"},
              {"type": "null"}
            ]
          },
          "active_from_sequence": {"type": "integer", "minimum": 0},
          "active_to_sequence": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Exclusive end sequence; null means active at run end."
          },
          "status": {"enum": ["ACTIVE", "FILLED", "CANCELLED"]},
          "tags": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "fills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fill_id",
          "order_key",
          "instrument",
          "sequence",
          "timestamp",
          "side",
          "price",
          "quantity"
        ],
        "properties": {
          "fill_id": {"type": "string", "minLength": 1},
          "order_key": {"type": "string", "minLength": 1},
          "instrument": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 0},
          "timestamp": {"type": "integer"},
          "date": {"type": "string", "format": "date"},
          "side": {"enum": ["BUY", "SELL"]},
          "price": {"$ref": "#/$defs/price"},
          "quantity": {"$ref": "#/$defs/price"},
          "tags": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "equity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "timestamp",
          "cash",
          "positions",
          "average_costs",
          "marks",
          "realized_pnl",
          "equity"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "timestamp": {"type": "integer"},
          "date": {"type": "string", "format": "date"},
          "cash": {"$ref": "#/$defs/price"},
          "positions": {"$ref": "#/$defs/decimalMap"},
          "average_costs": {"$ref": "#/$defs/decimalMap"},
          "marks": {"$ref": "#/$defs/decimalMap"},
          "realized_pnl": {"$ref": "#/$defs/price"},
          "equity": {"$ref": "#/$defs/price"},
          "equity_asset": {"type": "string", "minLength": 1},
          "account_metrics": {"$ref": "#/$defs/decimalMap"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "initial_equity": {"$ref": "#/$defs/price"},
        "final_cash": {"$ref": "#/$defs/price"},
        "final_positions": {"$ref": "#/$defs/decimalMap"},
        "final_average_costs": {"$ref": "#/$defs/decimalMap"},
        "realized_pnl": {"$ref": "#/$defs/price"},
        "final_equity": {"$ref": "#/$defs/price"},
        "equity_asset": {"type": "string", "minLength": 1},
        "final_account_metrics": {"$ref": "#/$defs/decimalMap"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "price": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
      ]
    },
    "decimalMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/price"}
    }
  },
  "additionalProperties": true
}

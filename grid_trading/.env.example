BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_COINM_BASE_URL=https://dapi.binance.com

GRID_DB_PATH=grid_trading.sqlite3
GRID_API_URL=http://127.0.0.1:8100
# For an independently running production instance, set a separate absolute runtime directory.
GRID_RUNTIME_DIR=
# Fixed grids can use fapi.binance.com only when explicitly set to 1.
GRID_ENABLE_BINANCE_LIVE_FIXED_GRID=0
GRID_POSITION_RECONCILE_INTERVAL_SEC=60
GRID_SCHEDULER_GAP_THRESHOLD_SEC=5
GRID_SCHEDULER_AUDIT_HEARTBEAT_SEC=30

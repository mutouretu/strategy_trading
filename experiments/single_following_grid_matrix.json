{
  "schema_version": "experiment-spec/v1",
  "experiment_id": "single-following-grid-matrix",
  "description": "2D 跟随网格多策略参数与多 Seed 批量实验",
  "scenario_groups": [
    {
      "key": "coinm-following-grid-matrix",
      "run_provider": "grid-simulation/v1",
      "markets": [
        {
          "key": "btc-3y-base",
          "type": "anchored-gbm/v1",
          "parameters": {
            "instrument": "BTCUSD_PERP",
            "anchors": [
              {"date": "2026-01-01", "price": "65000"},
              {"date": "2026-07-01", "price": "40000"},
              {"date": "2027-01-01", "price": "115000"},
              {"date": "2027-07-01", "price": "55000"},
              {"date": "2028-01-01", "price": "200000"},
              {"date": "2028-07-01", "price": "45000"},
              {"date": "2029-01-01", "price": "160000"}
            ],
            "annual_volatility": "0.60",
            "intraday_steps": 24,
            "periods_per_year": 365,
            "price_quantum": "0.01",
            "price_floor": "40000",
            "price_ceiling": "200000",
            "interval": "1d"
          }
        }
      ],
      "strategies": [
        {
          "key": "single-following-small",
          "type": "single-following-grid/v1",
          "parameters": {
            "strategy_id": "single-following-grid-small",
            "grid_id": "grid-rule-small",
            "instrument": "BTCUSD_PERP",
            "mode": "long",
            "anchor_price": "65000",
            "grid_ratio": "0.04",
            "grid_count": 5,
            "order_notional": "0",
            "tick_size": "0.1",
            "quantity_step": "1",
            "move_grid": true,
            "market_type": "coinm",
            "order_coin_quantity": "0.005",
            "contract_size": "100"
          }
        },
        {
          "key": "single-following-base",
          "type": "single-following-grid/v1",
          "parameters": {
            "strategy_id": "single-following-grid-base",
            "grid_id": "grid-rule-base",
            "instrument": "BTCUSD_PERP",
            "mode": "long",
            "anchor_price": "65000",
            "grid_ratio": "0.04",
            "grid_count": 5,
            "order_notional": "0",
            "tick_size": "0.1",
            "quantity_step": "1",
            "move_grid": true,
            "market_type": "coinm",
            "order_coin_quantity": "0.01",
            "contract_size": "100"
          }
        }
      ],
      "executions": [
        {
          "key": "daily-passive",
          "type": "daily-bar-execution/v1",
          "parameters": {
            "maker_fee_rate": "0.0002",
            "taker_fee_rate": "0.0005",
            "fee_asset": "BTC",
            "funding_model": "none"
          }
        }
      ],
      "accounts": [
        {
          "key": "coinm-long",
          "type": "coinm-inverse/v1",
          "parameters": {
            "instrument": "BTCUSD_PERP",
            "contract_size": "100",
            "spot_btc": "1",
            "futures_wallet_btc": "0.1",
            "base_asset": "BTC",
            "quote_asset": "USDT",
            "notional_asset": "USD",
            "margin_model": "none"
          }
        }
      ],
      "parameter_axes": [
        {
          "path": "/strategy/parameters/grid_count",
          "values": [3, 5]
        }
      ]
    }
  ],
  "seeds": [42, 43],
  "output": {
    "root": "experiment_results",
    "default_retention_class": "standard"
  },
  "controls": {
    "max_runs": 8,
    "continue_on_error": false
  },
  "metadata": {
    "purpose": "2D-cartesian-seed-parameter-matrix"
  }
}

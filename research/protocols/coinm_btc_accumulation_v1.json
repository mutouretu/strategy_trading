    {
      "key": "btc-max-drawdown",
      "selector": {
        "metric_set_id": "core",
        "metric_set_version": "v1",
        "metric_key": "risk.max_drawdown_rate",
        "unit": "ratio",
        "dimensions": {
          "scope": "account.futures_equity",
          "valuation_asset": "BTC"
        }
      },
      "direction": "MINIMIZE",
      "comparison": "DIRECT"
    }
  ],
  "eligibility_constraints": [
    {
      "key": "run-completed",
      "selector": {
        "metric_set_id": "core",
        "metric_set_version": "v1",
        "metric_key": "run.completed",
        "unit": "boolean",
        "dimensions": {}

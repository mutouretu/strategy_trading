{
  "schema_version": "objective-profile/v1",
  "profile_id": "coinm-btc-accumulation-v1",
  "description": "以 BTC 期末权益及相对 HODL 的超额 BTC 为主目标，USDT 权益仅作估值展示",
  "valuation_asset": "BTC",
  "baseline_strategy_type": "hold-btc/v1",
  "objectives": [
    {
      "key": "excess-btc-vs-hodl",
      "selector": {

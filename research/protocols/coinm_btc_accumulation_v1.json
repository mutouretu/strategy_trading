        "metric_set_version": "v1",
        "metric_key": "return.final_equity",
        "unit": "BTC",
        "dimensions": {
          "scope": "account.futures_equity",
          "valuation_asset": "BTC"
        }
      },
      "direction": "MAXIMIZE",
      "comparison": "DELTA_FROM_BASELINE"

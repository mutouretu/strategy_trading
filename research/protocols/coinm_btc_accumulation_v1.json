    {
      "key": "not-liquidated",
      "selector": {
        "metric_set_id": "core",
        "metric_set_version": "v1",
        "metric_key": "run.liquidated",
        "unit": "boolean",
        "dimensions": {}
      },
      "operator": "EQ",
      "value": false
    },
    {
      "key": "not-bankrupt",
      "selector": {
        "metric_set_id": "core",
        "metric_set_version": "v1",
        "metric_key": "run.bankrupt",
        "unit": "boolean",
        "dimensions": {}
      },
      "operator": "EQ",
      "value": false
    }
  ]
